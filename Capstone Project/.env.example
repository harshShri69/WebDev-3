# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/campus_management

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Faculty may correct an attendance record only within this many days of the class date
ATTENDANCE_CORRECTION_WINDOW_DAYS=7
# Default threshold (%) for the low-attendance report; can be overridden per request
DEFAULT_ATTENDANCE_THRESHOLD=75
